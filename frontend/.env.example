# localhost works when running in a web browser on the same machine
# as the backend. When testing on a physical phone via Expo Go, this
# MUST be your computer's LAN IP instead (e.g. http://192.168.1.23:8000/api/v1)
# -- find it with `ipconfig getifaddr en0` on macOS. It changes if you
# switch networks, so update it again if the app can't reach the server.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
